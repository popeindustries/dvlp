{
  "name": "dvlp",
  "version": "17.1.0-0",
  "description": "A no-nonsense dev server toolkit to help you develop quickly and easily for the web",
  "type": "module",
  "types": "dvlp.d.ts",
  "repository": "https://github.com/popeindustries/dvlp.git",
  "author": "Alexander Pope <alex@pope.industries>",
  "license": "MIT",
  "bin": {
    "dvlp": "bin/dvlp.js"
  },
  "exports": {
    ".": "./src/dvlp.ts",
    "./internal": "./src/dvlp-internal.ts",
    "./test-browser": "./src/dvlp-test-browser.ts",
    "./test": "./src/dvlp-test.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dvlp.js",
      "./internal": "./dvlp-internal.js",
      "./test-browser": "./dvlp-test-browser.js",
      "./test": "./dvlp-test.js"
    }
  },
  "dependencies": {
    "amaro": "^1.1.10",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@fidm/x509": "^1.2.1",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/platform": "^1.3.6",
    "@types/send": "^1.2.1",
    "chai": "^6.2.2",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cjs-module-lexer": "^2.2.0",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "electron": "43.1.0",
    "es-module-lexer": "^2.3.1",
    "eventsource": "^4.1.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.10.0",
    "faye-websocket": "^0.11.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "lit-html": "^3.3.3",
    "mocha": "^11.7.6",
    "oxlint": "^1.73.0",
    "path-to-regexp": "^8.4.2",
    "permessage-deflate": "^0.1.7",
    "platform": "^1.3.6",
    "prettier": "^3.9.5",
    "react": "^18.3.1",
    "resolve.exports": "^2.0.3",
    "semver": "^7.8.5",
    "terser": "^5.49.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "clean": "git clean -x -f",
    "format": "prettier --write './{src,test}/**/*.{js,ts,json}'",
    "lint": "pnpm run lint:src && pnpm run lint:types",
    "lint:src": "oxlint",
    "lint:types": "tsc --noEmit --skipLibCheck ",
    "prepublishOnly": "pnpm run build",
    "test": "cross-env NODE_ENV=dvlptest NODE_TLS_REJECT_UNAUTHORIZED='0' mocha --reporter spec --bail --exit --timeout 10000 --require ./test/unit/init.ts test/unit/index.ts",
    "test:all": "pnpm run test && pnpm run test:integration",
    "test:browser": "pnpm run build && ./bin/dvlp.js --mock test/browser/fixtures/mock test/browser",
    "test:integration": "pnpm run build && cross-env NODE_ENV=dvlptest mocha test/integration/*-test.ts --reporter spec --exit --timeout 10000",
    "prepare": "husky"
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "oxlint"
    ]
  },
  "files": [
    "bin",
    "*.d.ts",
    "*.js",
    "README.MD"
  ]
}
